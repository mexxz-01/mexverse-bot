<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="#090D16"
    android:padding="24dp">

    <!-- Top Badge -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚔️ MEXVERSE SMP"
        android:textColor="#34D399"
        android:textStyle="bold"
        android:textSize="12sp"
        android:letterSpacing="0.1"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:background="#1B332B"
        android:layout_marginBottom="12dp" />

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bot One-Click Switch"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Remote Discord Bot Controller"
        android:textColor="#64748B"
        android:textSize="13sp"
        android:layout_marginBottom="30dp" />

    <!-- Card Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/card_rounded"
        android:padding="26dp">

        <!-- Status Badge -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CONNECTING..."
            android:textColor="#10B981"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="20dp" />

        <!-- Power Button -->
        <Button
            android:id="@+id/btnPower"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:background="@drawable/btn_circle_green"
            android:text="⏻\nONLINE"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:stateListAnimator="@null"
            android:layout_marginBottom="25dp" />

        <!-- Stats Grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="10dp"
                android:background="#0F172A">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RAM USAGE"
                    android:textColor="#94A3B8"
                    android:textSize="10sp" />
                <TextView
                    android:id="@+id/tvRam"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="~45 MB"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="10dp"
                android:layout_height="match_parent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="10dp"
                android:background="#0F172A">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ACTIVE UPTIME"
                    android:textColor="#94A3B8"
                    android:textSize="10sp" />
                <TextView
                    android:id="@+id/tvUptime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00:00"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Restart Button -->
        <Button
            android:id="@+id/btnRestart"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/btn_action"
            android:text="🔄 Restart Discord Bot"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvServerIp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Host IP: 172.16.118.138:4444 (Tap to Change)"
        android:textColor="#475569"
        android:textSize="11sp"
        android:layout_marginTop="20dp" />

</LinearLayout>
